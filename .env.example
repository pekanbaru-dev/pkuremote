# ----------------------------------------------------------------------------
# PKU Remote — environment
# ----------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values. The app owns its own auth
# (Arctic + OIDC + DB-backed sessions) and its own Postgres — there is no
# Supabase. Do NOT commit a populated `.env`.
#
# The same shape works for dev and prod; only the values change:
#   - dev:  DATABASE_URL → the local/Docker Postgres; OIDC_ISSUER → local Dex
#   - prod: DATABASE_URL → the in-stack Postgres; OIDC_ISSUER → Google
# ----------------------------------------------------------------------------

# --- Database (single direct connection) -------------------------------------
# The app, `drizzle-kit` (migrations), and the seed all use this ONE URL — no
# pooler, no separate DIRECT_URL. Points at the app's own Postgres.
#   - host-run dev (pnpm dev) against the composed db:
#       postgresql://pkuremote:pkuremote@localhost:5432/pkuremote
#   - containerized app / prod (over the compose network):
#       postgresql://pkuremote:pkuremote@postgres:5432/pkuremote
DATABASE_URL=postgresql://pkuremote:pkuremote@localhost:5432/pkuremote

# --- In-stack Postgres credentials (dev + prod compose) ----------------------
# Consumed by the `postgres` service in docker-compose.yml / .prod.yml. Keep
# them consistent with the user/password/db embedded in DATABASE_URL above.
POSTGRES_USER=pkuremote
POSTGRES_PASSWORD=pkuremote
POSTGRES_DB=pkuremote

# --- OIDC (Arctic + jose) ----------------------------------------------------
# The app talks to a GENERIC OIDC issuer, so the same code path serves Dex in
# dev and Google in prod — only OIDC_ISSUER (and the client creds) differ.
#
# DEV (local Dex — see dex-config.yaml, and docs/local-dev-admin.md for topology):
#   OIDC_ISSUER=http://localhost:5556        # host-run `pnpm dev` (recommended)
#   OIDC_CLIENT_ID=pkuremote-dev
#   OIDC_CLIENT_SECRET=pkuremote-dev-secret
#   OIDC_REDIRECT_URI=http://localhost:5175/auth/callback
#
# PROD (Google — register an OAuth 2.0 Client in Google Cloud Console and add
# https://<your-domain>/auth/callback as an Authorized redirect URI):
#   OIDC_ISSUER=https://accounts.google.com
#   OIDC_CLIENT_ID=<google-client-id>
#   OIDC_CLIENT_SECRET=<google-client-secret>
#   OIDC_REDIRECT_URI=https://<your-domain>/auth/callback
OIDC_ISSUER=http://localhost:5556
OIDC_CLIENT_ID=pkuremote-dev
OIDC_CLIENT_SECRET=pkuremote-dev-secret
OIDC_REDIRECT_URI=http://localhost:5175/auth/callback

# --- Admin access (server-only) ----------------------------------------------
# Comma-separated administrator emails. A signed-in user is an admin iff their
# verified email is in this list (matched case-insensitively; surrounding
# whitespace ignored; supports multiple admins). Provider-independent — a Dex
# or Google identity is admin purely by whether its email is listed. Leave
# empty to have NO admins (the /admin panel is then inaccessible — fail closed).
ADMIN_EMAILS=admin@pkubersua.local

# --- Dev login bypass (server-only, DEV SERVER ONLY) -------------------------
# LOCAL DEVELOPMENT ONLY. When set AND running under `pnpm dev`, the app skips
# the OIDC/session lookup and signs you in as a synthetic user with this email
# — useful for admin UI work without a running IdP. Double-gated: `dev` is
# compiled to `false` in the production build, so a stray value in prod does
# nothing. Set it to an address also in ADMIN_EMAILS to reach /admin. To also
# make booking / /myprofile work under the bypass, run `pnpm db:seed-dev-admin`
# once (it provisions a real users + profiles row at the bypass user's id).
# Leave UNSET (comment out) to use the real Dex/Google login.
# DEV_ADMIN_EMAIL=admin@pkubersua.local

# --- Uploads (server-only) ---------------------------------------------------
# Directory where uploaded event banner images are written, OUTSIDE the
# SvelteKit build so runtime writes survive. Dev default is `./uploads`
# (gitignored); the Docker prod stack uses `/data/uploads`, backed by a named
# volume so uploads persist across redeploys.
UPLOAD_DIR=./uploads

# --- Production deploy (used by docker-compose.prod.yml / .deploy.yml) --------
# The FQDN this site serves (e.g. `pkuremote.example.com`). DNS A/AAAA must
# point at the host's public IP before the first deploy, otherwise Caddy
# cannot obtain a Let's Encrypt cert.
SITE_DOMAIN=pkuremote.example.com

# Contact email for the Let's Encrypt account. Required for cert issuance.
# ACME_EMAIL=you@example.com

# Internal port the SvelteKit Node server binds to inside the `app` container.
# NOT published to the host — Caddy reverse-proxies to it.
APP_PORT=3000

# --- SvelteKit FE (browser-visible, baked at build time) ---------------------
# Public base URL used to build absolute URLs in SSR metadata (canonical link,
# sitemap, Open Graph). Include the scheme, no trailing slash.
#   - dev:  http://localhost:5175
#   - prod: https://pkubersua.com
PUBLIC_SITE_URL=http://localhost:5175

# Public contact email shown in the footer and used as the default booking
# destination on event detail pages. Baked into the client bundle at build time.
PUBLIC_CONTACT_EMAIL=hello@pkubersua.com

# --- Google Stitch MCP -------------------------------------------------------
# API key for the Google Stitch MCP server. Consumed by opencode.json,
# .agents/mcp.json, .claude/.mcp.json, and .codex/config.toml.
STITCH_API_KEY=YOUR_GOOGLE_STITCH_API_KEY

# --- OpenCode AI provider ----------------------------------------------------
# API key for the AI provider registered in `opencode.json`.
OPENCODE_API_KEY=YOUR_OPENCODE_API_KEY
