# ----------------------------------------------------------------------------
# PKU Remote — Supabase environment
# ----------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values from your Supabase Cloud
# project's dashboard (https://supabase.com/dashboard):
#
#   - API Settings       -> Project URL, anon key, service_role key
#   - Database Settings  -> Connection string (pooler) and Direct connection
#
# The same shape works for dev (free-tier project) and prod (paid project);
# only the URL and keys change. Do NOT commit a populated `.env`.
# ----------------------------------------------------------------------------

# --- SvelteKit FE (browser-visible) ------------------------------------------
# Project URL of your Supabase project. Used by `@supabase/supabase-js` in the
# browser to reach Auth, PostgREST, Storage, and Realtime.
PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# The anon key is safe to expose to the browser. Row Level Security is the
# real access control; this key is signed by your project's JWT secret.
PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# --- SvelteKit FE (server-only) ----------------------------------------------
# The service role key bypasses RLS. MUST stay on the server. Imported only
# from `$lib/server/**` and from `db/seed.ts`.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# --- Admin access (server-only) ----------------------------------------------
# Comma-separated list of administrator email addresses. A signed-in user is
# treated as an admin iff their Google email is in this list (matched
# case-insensitively; surrounding whitespace ignored). Supports multiple
# admins. Leave empty to have NO admins (the /admin panel is then inaccessible
# to everyone — fail closed). Read only from `$lib/server/**`.
ADMIN_EMAILS=admin@example.com

# --- Uploads (server-only) ---------------------------------------------------
# Directory where uploaded event banner images are written, OUTSIDE the
# SvelteKit build so runtime writes survive. Files are served by the
# `/uploads/[file]` route. Dev default is `./uploads` (gitignored); in the
# Docker prod stack this is `/data/uploads`, backed by a named volume so
# uploads persist across redeploys. Read only from `$lib/server/**`.
UPLOAD_DIR=./uploads

# --- Drizzle / Postgres ------------------------------------------------------
# Pooled connection used by the FE at runtime. Goes through the Supabase
# transaction pooler (Supavisor) on port 6543. Find this under
# Database Settings -> Connection string -> "Transaction pooler".
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Direct connection used by `drizzle-kit` (migrations) and `db/seed.ts`. The
# pooler cannot run DDL, so migrations and seed MUST use this URL. Find this
# under Database Settings -> Connection string -> "Direct connection".
DIRECT_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# --- SvelteKit FE (browser-visible) ------------------------------------------
# Public base URL used to build absolute URLs in SSR metadata (canonical link,
# sitemap entries, Open Graph). Must include the scheme and have no trailing
# slash. In dev it defaults to http://localhost:5173; set this in production.
PUBLIC_SITE_URL=http://localhost:5173

# --- Production deploy (used by docker-compose.prod.yml) --------------------
# The FQDN this site serves (e.g. `pkuremote.example.com`). DNS A/AAAA must
# point at the host's public IP before the first deploy, otherwise Caddy
# cannot obtain a Let's Encrypt cert.
SITE_DOMAIN=pkuremote.example.com

# Contact email for the Let's Encrypt account. Required for cert issuance;
# Caddy passes it to LE on first request and LE uses it to warn about
# expiring certs.
# ACME_EMAIL=you@example.com

# Internal port the SvelteKit Node server binds to inside the `app` container.
# NOT published to the host — Caddy reverse-proxies to it. Do not change
# unless you also change the `Caddyfile` reverse_proxy line.
APP_PORT=3000

# --- Google Stitch MCP ------------------------------------------------------
# API key for the Google Stitch MCP server
# (https://stitch.googleapis.com/mcp). Consumed by:
#   - opencode.json           → mcp.stitch.headers.X-Goog-Api-Key
#   - .agents/mcp.json        → mcp.stitch.headers.X-Goog-Api-Key
#   - .claude/.mcp.json       → mcpServers.stitch.headers.X-Goog-Api-Key
#   - .codex/config.toml      → mcp_servers.stitch.env_http_headers.X-Goog-Api-Key
# Get your key from the Google AI Studio / Stitch dashboard.
STITCH_API_KEY=YOUR_GOOGLE_STITCH_API_KEY

# --- OpenCode AI provider ---------------------------------------------------
# API key for the AI provider registered in `opencode.json` (provider
# `cosmoshub` → `options.apiKey`). The literal value lives only in `.env`
# (gitignored) or `~/.zshenv`; `opencode.json` references it as
# `"{env:OPENCODE_API_KEY}"`.
OPENCODE_API_KEY=YOUR_OPENCODE_API_KEY

# --- Site ---------------------------------------------------------------------
# Public base URL used to build absolute URLs in SSR metadata (canonical link,
# sitemap entries, Open Graph). Must include the scheme and have no trailing
# slash.
#   - dev:    http://localhost:5173
#   - prod:   https://pkubersua.com
PUBLIC_SITE_URL=http://localhost:5173

# Public contact email shown in the footer and used as the default booking
# destination on event detail pages. Baked into the client bundle by
# `$env/static/public`, so it must be set at build time (Docker ARG).
#   - dev:    hello@pkubersua.com
#   - prod:   hello@pkubersua.com
PUBLIC_CONTACT_EMAIL=hello@pkubersua.com
