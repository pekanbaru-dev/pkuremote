{
	"$schema": "https://opencode.ai/config.json",
	"mcp": {
		"serena": {
			"type": "local",
			"command": ["serena", "start-mcp-server", "--context=codex", "--project-from-cwd"],
			"enabled": true
		},
		"codebase-memory-mcp": {
			"type": "local",
			"command": ["codebase-memory-mcp"],
			"enabled": true
		},
		"context7": {
			"type": "local",
			"command": ["npx", "-y", "@upstash/context7-mcp"],
			"enabled": true
		},
		"stitch": {
			"type": "remote",
			"url": "https://stitch.googleapis.com/mcp",
			"enabled": true,
			"headers": {
				"X-Goog-Api-Key": "{env:STITCH_API_KEY}"
			}
		}
	},
	"instructions": ["AGENTS.md"],
	"provider": {
		"cosmoshub": {
			"npm": "@ai-sdk/openai-compatible",
			"name": "CosmosHub",
			"options": {
				"baseURL": "https://api.cosmoshub.tech/v1",
				"apiKey": "sk-cos-GzYXkW51H5XxnjEOx9YtB_C2HFQ2nc-EKQsI466GMjQ"
			},
			"models": {
				"qwen-3.7-max": { "name": "Qwen 3.7 Max" },
				"gemini-3.5-flash": { "name": "Gemini 3.5 Flash" },
				"gemini-3.1-pro": { "name": "Gemini 3.1 Pro" },
				"mimo-v2.5": { "name": "MiMo v2.5" },
				"mimo-v2.5-pro": { "name": "MiMo v2.5 Pro" },
				"kimi-k2.7-code": { "name": "Kimi K2.7 Code" },
				"glm-5.2": { "name": "GLM 5.2" },
				"deepseek-v4-pro": { "name": "DeepSeek V4 Pro" },
				"deepseek-v4-flash": { "name": "DeepSeek V4 Flash" },
				"claude-opus-4.8": { "name": "Claude Opus 4.8" }
			}
		}
	}
}
