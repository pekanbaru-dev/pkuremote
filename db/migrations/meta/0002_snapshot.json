				"events_status_check": {
					"name": "events_status_check",
					"value": "\"events\".\"status\" IN ('upcoming', 'live', 'past')"
				},
				"events_category_check": {
					"name": "events_category_check",
					"value": "\"events\".\"category\" IN ('workshop', 'talk', 'meetup', 'social', 'other') OR \"events\".\"category\" IS NULL"
				},
				"events_remaining_slots_check": {
					"name": "events_remaining_slots_check",
					"value": "\"events\".\"remaining_slots\" IS NULL OR \"events\".\"remaining_slots\" >= 0"
				},
				"events_quota_check": {
					"name": "events_quota_check",
					"value": "\"events\".\"quota\" IS NULL OR \"events\".\"quota\" > 0"
				},
				"events_price_promo_check": {
					"name": "events_price_promo_check",
					"value": "\"events\".\"price_promo\" IS NULL OR \"events\".\"price_normal\" IS NULL OR \"events\".\"price_promo\" < \"events\".\"price_normal\""
				}
