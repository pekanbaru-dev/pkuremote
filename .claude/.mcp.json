{
	"mcpServers": {
		"serena": {
			"type": "stdio",
			"command": "serena",
			"args": ["start-mcp-server", "--context=claude-code", "--project-from-cwd"],
			"env": {}
		},
		"codebase-memory-mcp": {
			"type": "stdio",
			"command": "codebase-memory-mcp",
			"args": [],
			"env": {}
		},
		"context7": {
			"type": "stdio",
			"command": "npx",
			"args": ["-y", "@upstash/context7-mcp"],
			"env": {}
		},
		"stitch": {
			"type": "http",
			"url": "https://stitch.googleapis.com/mcp",
			"headers": {
				"X-Goog-Api-Key": "${STITCH_API_KEY}"
			}
		}
	}
}